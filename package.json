{
  "name": "mt-unipos",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "dist:win": "next build && electron-builder --win nsis"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/postcss": "^4",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.0.4",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-barcode": "^1.6.1",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "typescript": "^5",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.mtunipos.desktop",
    "productName": "MT UniPOS",
    "copyright": "Copyright © 2026 Founder Mian Talal",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo.jpg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MT UniPOS",
      "uninstallDisplayName": "Uninstall MT UniPOS ERP"
    }
  }
}
